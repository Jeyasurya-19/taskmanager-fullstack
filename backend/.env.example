# --- Local MySQL example ---
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/taskmanager

# --- TiDB Cloud Serverless example (MySQL-compatible) ---
# Get these values from the TiDB Cloud console -> your cluster -> Connect
# TiDB requires SSL, hence the ssl_verify_cert / ssl_verify_identity params
# DATABASE_URL=mysql+pymysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/taskmanager?ssl_verify_cert=true&ssl_verify_identity=true

DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/taskmanager

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
